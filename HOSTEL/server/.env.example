# Environment Variables — Copy this file to .env and fill in values
# NEVER commit .env to source control

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# Local Docker (matches docker/docker-compose.yml)
DATABASE_URL="postgresql://hostel_user:hostel_dev_pass_2024@localhost:5432/hostel_management"

# Render.com (fill in when deploying)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRES_IN=24h

# ─── SMS (Phase 3 — leave empty for now) ──────────────────────────────────────
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=HOSTEL
